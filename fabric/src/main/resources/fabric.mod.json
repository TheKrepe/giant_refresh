    "Star_1mp"
  ],
  "license": "All-Rights-Reserved",
  "icon": "assets/giant_refresh/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.star1mp.giantrefresh.fabric.GiantRefreshFabric"
    ],
    "client": [
      "dev.star1mp.giantrefresh.fabric.GiantRefreshFabricClient"
    ]
  },
  "mixins": [
    "giant_refresh.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
